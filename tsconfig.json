{
	"compilerOptions": {
		"baseUrl": "./src",
		"inlineSourceMap": true,
		"inlineSources": true,
		"module": "ESNext",
		"target": "ES2020",
		"allowJs": true,
		"noImplicitAny": true,
		"moduleResolution": "node",
		"importHelpers": true,
		"isolatedModules": true,
		"strict": true,
		"strictNullChecks": true,
		"noUncheckedIndexedAccess": true,
		"lib": [
			"DOM",
			"ES2020",
			"ES2021",
			"ES2022",
			"ES2021.String",
			"DOM.Iterable"
		]
	},
	"include": ["**/*.ts"],
	"exclude": ["src/legacy/*.ts"]
}
